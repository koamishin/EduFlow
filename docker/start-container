#!/usr/bin/env sh
set -e

container_mode=${CONTAINER_MODE:-"http"}
octane_server=${OCTANE_SERVER:-"frankenphp"}
running_migrations_and_seeders=${RUNNING_MIGRATIONS_AND_SEEDERS:-"false"}

ROOT=${ROOT:-/app}
export ROOT

# Persist / generate APP_KEY automatically for self-hosted installs.
if [ -z "${APP_KEY}" ]; then
    key_file="${ROOT}/storage/framework/.app_key"
    if [ -f "${key_file}" ]; then
        APP_KEY=$(cat "${key_file}")
    else
        mkdir -p "${ROOT}/storage/framework"
        APP_KEY=$(php -r "echo 'base64:'.base64_encode(random_bytes(32));")
        echo "${APP_KEY}" > "${key_file}"
    fi
    export APP_KEY
fi

# If .env exists in ROOT and APP_KEY is empty in .env, persist it
if [ -f "${ROOT}/.env" ] && grep -q '^APP_KEY=$' "${ROOT}/.env" 2>/dev/null; then
    sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" "${ROOT}/.env" 2>/dev/null || true
fi

# Read the database password from a mounted secret file when provided
# (Docker Swarm mounts secrets under /run/secrets by default).
if [ -z "${DB_PASSWORD:-}" ] && [ -n "${DB_PASSWORD_FILE:-}" ] && [ -f "${DB_PASSWORD_FILE}" ]; then
    DB_PASSWORD=$(cat "${DB_PASSWORD_FILE}")
    export DB_PASSWORD
fi

# Ensure SQLite database file and directory exist if SQLite is used
ensure_sqlite_db() {
    db_conn="${DB_CONNECTION:-sqlite}"
    if [ "${db_conn}" = "sqlite" ]; then
        db_file="${DB_DATABASE:-${ROOT}/storage/database.sqlite}"
        case "$db_file" in
            */*) ;;
            *) db_file="${ROOT}/storage/${db_file}.sqlite" ;;
        esac
        export DB_DATABASE="$db_file"
        db_dir=$(dirname "${db_file}")
        mkdir -p "${db_dir}"
        if [ ! -f "${db_file}" ]; then
            echo "Creating SQLite database at ${db_file}..."
            touch "${db_file}"
        fi
        chown -R "${USER:-laravel}:${USER:-laravel}" "${db_dir}" 2>/dev/null || true
        chmod 775 "${db_dir}" 2>/dev/null || true
        chown "${USER:-laravel}:${USER:-laravel}" "${db_file}" 2>/dev/null || true
        chmod 664 "${db_file}" 2>/dev/null || true
    fi
}

fix_permissions() {
    chown -R "${USER:-laravel}:${USER:-laravel}" "${ROOT}/storage" "${ROOT}/bootstrap/cache" "${ROOT}/.config" "${ROOT}/.data" 2>/dev/null || true
    chmod -R 775 "${ROOT}/storage" "${ROOT}/bootstrap/cache" "${ROOT}/.config" "${ROOT}/.data" 2>/dev/null || true

    for dir in "${ROOT}/database" "/var/www/html/database"; do
        if [ -d "$dir" ]; then
            chown -R "${USER:-laravel}:${USER:-laravel}" "$dir" 2>/dev/null || true
            chmod 775 "$dir" 2>/dev/null || true
        fi
    done

    db_conn="${DB_CONNECTION:-sqlite}"
    if [ "${db_conn}" = "sqlite" ]; then
        db_file="${DB_DATABASE:-${ROOT}/storage/database.sqlite}"
        case "$db_file" in
            */*) ;;
            *) db_file="${ROOT}/storage/${db_file}.sqlite" ;;
        esac
        db_dir=$(dirname "${db_file}")
        if [ -d "${db_dir}" ]; then
            chown -R "${USER:-laravel}:${USER:-laravel}" "${db_dir}" 2>/dev/null || true
            chmod 775 "${db_dir}" 2>/dev/null || true
        fi
        if [ -f "${db_file}" ]; then
            chown "${USER:-laravel}:${USER:-laravel}" "${db_file}" 2>/dev/null || true
            chmod 664 "${db_file}" 2>/dev/null || true
        fi
        for wal in "${db_file}-wal" "${db_file}-shm"; do
            if [ -f "$wal" ]; then
                chown "${USER:-laravel}:${USER:-laravel}" "$wal" 2>/dev/null || true
                chmod 664 "$wal" 2>/dev/null || true
            fi
        done
    fi
}

init_application() {
    echo "Preparing application..."
    ensure_sqlite_db
    fix_permissions
    php artisan module:enable Blog --no-interaction || true
    php artisan migrate --force --no-interaction || true
    php artisan module:migrate --force --no-interaction || true
    php artisan storage:link || true

    if [ ! -f "${ROOT}/storage/.opensinop_installed" ] && [ ! -f "${ROOT}/storage/.eduflow_installed" ]; then
        echo "Initializing OpenSinop institution..."
        if php artisan app:install \
            --institution="${EDUFLOW_INSTITUTION:-My School}" \
            --country="${EDUFLOW_COUNTRY:-US}" \
            --timezone="${EDUFLOW_TIMEZONE:-UTC}" \
            --locale="${EDUFLOW_LOCALE:-en}" \
            --currency="${EDUFLOW_CURRENCY:-USD}" \
            --no-interaction; then
            touch "${ROOT}/storage/.opensinop_installed"
            fix_permissions
            echo "Institution initialized."
            echo "Create the first administrator:"
            echo "  docker exec -it opensinop php artisan app:bootstrap-admin --name=\"School Operator\" --email=\"operator@example.org\""
        else
            echo "Institution initialization was skipped or failed (possibly already initialized). Continuing."
        fi
    fi

    fix_permissions
}

initialStuff() {
    echo "Container mode: $container_mode"

    if [ ! -d "${ROOT}/vendor/laravel/horizon" ]; then
        echo "Horizon not installed. Disabling Horizon supervisor config."
        if [ -f "/etc/supervisor/conf.d/supervisord.horizon.conf" ]; then
            echo "" > /etc/supervisor/conf.d/supervisord.horizon.conf
        fi
    fi

    if [ ! -d "${ROOT}/vendor/laravel/pulse" ]; then
        if [ -f "/etc/supervisor/conf.d/supervisord.pulse.conf" ]; then
            echo "Pulse not installed. Disabling Pulse supervisor config."
            echo "" > /etc/supervisor/conf.d/supervisord.pulse.conf
        fi
    fi

    if [ ! -d "${ROOT}/vendor/laravel/telescope" ]; then
        if [ -f "/etc/supervisor/conf.d/supervisord.telescope.conf" ]; then
            echo "Telescope not installed. Disabling Telescope supervisor config."
            echo "" > /etc/supervisor/conf.d/supervisord.telescope.conf
        fi
    fi

    init_application

    php artisan optimize:clear || true
    php artisan optimize || true
}

if [ "$1" != "" ]; then
    exec "$@"
elif [ "${container_mode}" = "http" ]; then
    initialStuff
    echo "Octane Server: $octane_server"
    if [ "${octane_server}"  = "frankenphp" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.frankenphp.conf
    elif [ "${octane_server}"  = "swoole" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.swoole.conf
    elif [ "${octane_server}"  = "roadrunner" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.roadrunner.conf
    else
        echo "Invalid Octane server supplied."
        exit 1
    fi
elif [ "${container_mode}" = "horizon" ]; then
    initialStuff
    exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.horizon.conf
elif [ "${container_mode}" = "scheduler" ]; then
    initialStuff
    exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.scheduler.conf
elif [ "${container_mode}" = "reverb" ]; then
    initialStuff
    exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.reverb.conf
elif [ "${container_mode}" = "worker" ]; then
    if [ -z "${WORKER_COMMAND}" ]; then
        echo "WORKER_COMMAND is undefined."
        exit 1
    fi
    initialStuff
    exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.worker.conf
else
    echo "Container mode mismatched."
    exit 1
fi
